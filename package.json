{
  "name": "maple-math-mysteries",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "generate": "node --experimental-strip-types scripts/run-generate.ts",
    "build": "vite build",
    "lint": "oxlint src tests vite.config.ts && stylelint src/**/*.css",
