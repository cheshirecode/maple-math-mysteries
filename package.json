    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "oxlint": "^1.93.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
